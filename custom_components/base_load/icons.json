{
  "entity": {
    "sensor": {
      "expected": {
        "default": "mdi:home-clock"
      },
      "current": {
        "default": "mdi:home-lightning-bolt"
      },
      "deviation": {
        "default": "mdi:plus-minus-variant"
      },
      "last_night": {
        "default": "mdi:weather-night"
      },
      "cause": {
        "default": "mdi:magnify-expand"
      },
      "last_night_cause": {
        "default": "mdi:magnify-expand"
      },
      "data_quality": {
        "default": "mdi:database-check"
      },
      "annual_cost": {
        "default": "mdi:cash-multiple"
      },
      "deviation_cost": {
        "default": "mdi:cash-plus"
      },
      "unmeasured": {
        "default": "mdi:help-circle-outline"
      },
      "level_shift": {
        "default": "mdi:stairs-up"
      },
      "detected_appliances": {
        "default": "mdi:radar"
      },
      "appliance_power": {
        "default": "mdi:power-plug"
      },
      "appliance_energy": {
        "default": "mdi:lightning-bolt"
      }
    },
    "binary_sensor": {
      "anomaly": {
        "default": "mdi:home-alert",
        "state": {
          "off": "mdi:home-check"
        }
      },
      "last_night_anomaly": {
        "default": "mdi:moon-waning-crescent",
        "state": {
          "on": "mdi:home-alert"
        }
      },
      "data_incomplete": {
        "default": "mdi:database-alert",
        "state": {
          "off": "mdi:database-check"
        }
      }
    }
  },
  "services": {
    "mark_normal": {
      "service": "mdi:check-circle-outline"
    },
    "label_night": {
      "service": "mdi:tag-outline"
    },
    "name_appliance": {
      "service": "mdi:tag-text-outline"
    },
    "forget_appliance": {
      "service": "mdi:delete-outline"
    }
  }
}
