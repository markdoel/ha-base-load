{
  "config": {
    "step": {
      "user": {
        "title": "Base Load Monitor",
        "description": "Learns the normal night-time base load from long-term statistics and flags unusual deviations.",
        "data": {
          "name": "Name",
          "grid_sensor": "Grid power sensor",
          "feed_in_sensors": "Local sources (PV, battery)",
          "excluded_sensors": "Loads to exclude (e.g. EV charger)",
          "night_start": "Night window start",
          "night_end": "Night window end",
          "lookback_weeks": "Learning period (weeks)",
          "sensitivity": "Sensitivity (robust sigma)",
          "min_deviation": "Minimum deviation",
          "excluded_threshold": "Excluded load threshold",
          "candidate_sensors": "Devices for cause analysis",
          "half_life_days": "Half life of the baseline",
          "presence_entity": "Presence",
          "price_entity": "Electricity price",
          "notify_service": "Notification service",
          "notify_time": "Notification time"
        },
        "data_description": {
          "grid_sensor": "Power from the grid in W. Negative values mean export.",
          "feed_in_sensors": "Power fed into the house by PV inverters or batteries. Added to the grid power.",
          "excluded_sensors": "Hours in which one of these loads exceeds the threshold are ignored.",
          "night_start": "Full hour, local time. The window may wrap past midnight.",
          "sensitivity": "Lower values report more deviations. 3 is a good start.",
          "min_deviation": "Deviations smaller than this are never reported.",
          "candidate_sensors": "Measured devices (plugs, sub-meters) that are checked when the base load deviates. Do not combine a group sensor with its members.",
          "half_life_days": "Nights this many days old count half. Lower values follow lasting changes (heating season) faster. 0 weighs all nights equally.",
          "presence_entity": "Nights in which nobody was home are skipped and left out of the baseline. zone.home (away at 0 persons), a person or group (away unless home), or a holiday switch (on means away).",
          "price_entity": "Sensor or number with the price per kWh, e.g. EUR/kWh or ct/kWh. Dynamic prices are averaged over 30 days from statistics.",
          "notify_service": "e.g. notify.mobile_app_pixel. Sends a morning message after unusual nights and on new base load levels, with buttons to confirm or name the cause. Leave empty to disable."
        }
      }
    },
    "error": {
      "duplicate_sensor": "A sensor is selected more than once.",
      "empty_window": "Start and end of the night window must differ.",
      "unknown_notify_service": "Unknown notify service. Use the full name, e.g. notify.mobile_app_pixel."
    },
    "abort": {
      "already_configured": "This grid sensor is already monitored."
    }
  },
